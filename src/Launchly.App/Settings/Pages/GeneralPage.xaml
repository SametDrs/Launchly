<UserControl x:Class="Launchly.App.SettingsUi.Pages.GeneralPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Launchly.App.Localization">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
        <StackPanel Margin="28,22,28,20">
            <TextBlock Text="{loc:T general.title}" Style="{StaticResource PageTitleStyle}" />

            <TextBlock Text="{loc:T general.hotkey}" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,4" />
            <TextBlock Text="{loc:T general.hotkey.hint}"
                       Style="{StaticResource HintTextStyle}" Margin="0,0,0,8" />
            <TextBox x:Name="HotkeyBox" Width="220" HorizontalAlignment="Left" IsReadOnly="True"
                     Style="{StaticResource FieldTextBoxStyle}" Text="{Binding Hotkey, Mode=OneWay}"
                     PreviewKeyDown="OnHotkeyKeyDown" AutomationProperties.Name="{loc:T general.hotkey}" />

            <TextBlock Text="{loc:T general.behavior}" Style="{StaticResource SectionTitleStyle}" Margin="0,24,0,8" />
            <CheckBox Content="{loc:T general.hideOnFocusLost}" IsChecked="{Binding HideOnFocusLost}" Style="{StaticResource DarkCheckBoxStyle}" />
            <CheckBox Content="{loc:T general.startup}" IsChecked="{Binding StartOnSystemStartup}" Style="{StaticResource DarkCheckBoxStyle}" Margin="0,8,0,0" />

            <TextBlock Text="{loc:T general.language}" Style="{StaticResource SectionTitleStyle}" Margin="0,24,0,4" />
            <TextBlock Text="{loc:T general.language.hint}"
                       Style="{StaticResource HintTextStyle}" Margin="0,0,0,10" />
            <StackPanel Orientation="Horizontal">
                <RadioButton Content="{loc:T language.auto}" GroupName="Language" IsChecked="{Binding IsLanguageAuto}" Style="{StaticResource PillRadioStyle}" />
                <RadioButton Content="{loc:T language.tr}" GroupName="Language" IsChecked="{Binding IsLanguageTurkish}" Style="{StaticResource PillRadioStyle}" />
                <RadioButton Content="{loc:T language.en}" GroupName="Language" IsChecked="{Binding IsLanguageEnglish}" Style="{StaticResource PillRadioStyle}" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
