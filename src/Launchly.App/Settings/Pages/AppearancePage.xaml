<UserControl x:Class="Launchly.App.SettingsUi.Pages.AppearancePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Launchly.App.Localization">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
        <StackPanel Margin="28,22,28,20">
            <TextBlock Text="{loc:T appearance.title}" Style="{StaticResource PageTitleStyle}" />

            <TextBlock Text="{loc:T appearance.theme}" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,4" />
            <TextBlock Text="{loc:T appearance.theme.hint}"
                       Style="{StaticResource HintTextStyle}" Margin="0,0,0,10" />
            <StackPanel Orientation="Horizontal">
                <RadioButton Content="{loc:T appearance.dark}" GroupName="Backdrop" IsChecked="{Binding IsBackdropNone}" Style="{StaticResource PillRadioStyle}" />
                <RadioButton Content="{loc:T appearance.mica}" GroupName="Backdrop" IsChecked="{Binding IsBackdropMica}"
                             IsEnabled="{Binding IsBackdropSupported}" Style="{StaticResource PillRadioStyle}" />
                <RadioButton Content="{loc:T appearance.acrylic}" GroupName="Backdrop" IsChecked="{Binding IsBackdropAcrylic}"
                             IsEnabled="{Binding IsBackdropSupported}" Style="{StaticResource PillRadioStyle}" />
            </StackPanel>

            <!-- Desteklenmiyorsa neden (Windows sürümü ya da kapalı saydamlık); seçili tür yine düz koyu olarak uygulanır. -->
            <Border x:Name="UnavailableCard" Margin="0,12,0,0">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource CardStyle}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsBackdropSupported}" Value="False">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE946;" FontFamily="{StaticResource IconFont}" FontSize="14"
                               Foreground="{StaticResource SubTextBrush}" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <TextBlock FontSize="13" Foreground="{StaticResource TextBrush}" TextWrapping="Wrap" VerticalAlignment="Center">
                        <Run Text="{Binding BackdropUnavailableReason, Mode=OneWay}" /><Run Text="{loc:T appearance.unavailable}" />
                    </TextBlock>
                </StackPanel>
            </Border>

            <TextBlock Style="{StaticResource HintTextStyle}" Margin="0,14,0,0">
                <Run Text="{loc:T appearance.desc.dark}" /><LineBreak />
                <Run Text="{loc:T appearance.desc.mica}" /><LineBreak />
                <Run Text="{loc:T appearance.desc.acrylic}" />
            </TextBlock>
        </StackPanel>
    </ScrollViewer>
</UserControl>
