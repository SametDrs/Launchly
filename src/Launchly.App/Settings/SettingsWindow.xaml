<Window x:Class="Launchly.App.SettingsUi.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Launchly.App.SettingsUi"
        xmlns:loc="clr-namespace:Launchly.App.Localization"
        Title="{loc:T settings.window.title}"
        Icon="pack://application:,,,/Assets/Launchly.ico"
        Width="900" Height="600" MinWidth="760" MinHeight="500"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        UseLayoutRounding="True">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="210" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Sol menü -->
        <Border Grid.Column="0" Grid.Row="0" Background="{DynamicResource FooterBrush}"
                BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,1,0">
            <DockPanel Margin="10,16,10,10">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="8,0,0,18">
                    <Image Source="pack://application:,,,/Assets/Launchly.png" Width="28" Height="28"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="Launchly" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"
                               VerticalAlignment="Center" Margin="10,0,0,0" />
                </StackPanel>
                <ListBox x:Name="NavList" Style="{StaticResource NavListStyle}"
                         ItemContainerStyle="{StaticResource NavItemStyle}"
                         SelectedValuePath="Tag"
                         SelectedValue="{Binding SelectedPage, Mode=TwoWay}"
                         AutomationProperties.Name="{loc:T settings.nav.automation}">
                    <ListBoxItem Tag="{x:Static local:SettingsPage.General}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE713;" FontFamily="{StaticResource IconFont}" FontSize="16" Width="28" VerticalAlignment="Center" />
                            <TextBlock Text="{loc:T nav.general}" FontSize="14" VerticalAlignment="Center" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="{x:Static local:SettingsPage.Appearance}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE790;" FontFamily="{StaticResource IconFont}" FontSize="16" Width="28" VerticalAlignment="Center" />
                            <TextBlock Text="{loc:T nav.appearance}" FontSize="14" VerticalAlignment="Center" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="{x:Static local:SettingsPage.SearchSources}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE774;" FontFamily="{StaticResource IconFont}" FontSize="16" Width="28" VerticalAlignment="Center" />
                            <TextBlock Text="{loc:T nav.sources}" FontSize="14" VerticalAlignment="Center" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="{x:Static local:SettingsPage.Plugins}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xEA86;" FontFamily="{StaticResource IconFont}" FontSize="16" Width="28" VerticalAlignment="Center" />
                            <TextBlock Text="{loc:T nav.plugins}" FontSize="14" VerticalAlignment="Center" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="{x:Static local:SettingsPage.About}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE946;" FontFamily="{StaticResource IconFont}" FontSize="16" Width="28" VerticalAlignment="Center" />
                            <TextBlock Text="{loc:T nav.about}" FontSize="14" VerticalAlignment="Center" />
                        </StackPanel>
                    </ListBoxItem>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- Seçili sayfa (sayfa örnekleri yeniden kullanılır; taslak ViewModel'de) -->
        <ContentControl x:Name="PageHost" Grid.Column="1" Grid.Row="0" Focusable="False" />

        <!-- Ortak alt çubuk -->
        <Border Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="1" Background="{DynamicResource FooterBrush}"
                BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,1,0,0" Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding Message}" TextWrapping="Wrap"
                           VerticalAlignment="Center" Margin="0,0,12,0" FontSize="12.5">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsError}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource ErrorBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="{loc:T settings.revert}" Style="{StaticResource PushButtonStyle}" Margin="0,0,8,0" Click="OnRevert"
                            ToolTip="{loc:T settings.revert.tip}" />
                    <Button Content="{loc:T settings.apply}" Style="{StaticResource AccentButtonStyle}" Margin="0,0,8,0" Click="OnApply" IsDefault="True"
                            ToolTip="{loc:T settings.apply.tip}" />
                    <Button Content="{loc:T settings.close}" Style="{StaticResource PushButtonStyle}" Click="OnClose" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
