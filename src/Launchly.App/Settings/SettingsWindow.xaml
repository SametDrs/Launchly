<Window x:Class="Launchly.App.SettingsUi.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Launchly Ayarları"
        Width="720" Height="640" MinWidth="620" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBackgroundBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        UseLayoutRounding="True">
    <Grid Margin="24,20,24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Kısayol" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                <TextBlock Text="Kutuya tıklayıp yeni tuş birleşimine basın (Ctrl, Alt ya da Win'den en az biri gerekir)."
                           Foreground="{StaticResource SubTextBrush}" FontSize="12" Margin="0,2,0,8" />
                <TextBox x:Name="HotkeyBox" Width="220" HorizontalAlignment="Left" IsReadOnly="True"
                         Style="{StaticResource FieldTextBoxStyle}" Text="{Binding Hotkey, Mode=OneWay}"
                         PreviewKeyDown="OnHotkeyKeyDown" />

                <TextBlock Text="Görünüm" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Margin="0,24,0,8" />
                <StackPanel Orientation="Horizontal">
                    <RadioButton Content="Yok" GroupName="Backdrop" IsChecked="{Binding IsBackdropNone}" Style="{StaticResource PillRadioStyle}" />
                    <RadioButton Content="Mica" GroupName="Backdrop" IsChecked="{Binding IsBackdropMica}" Style="{StaticResource PillRadioStyle}" />
                    <RadioButton Content="Acrylic" GroupName="Backdrop" IsChecked="{Binding IsBackdropAcrylic}" Style="{StaticResource PillRadioStyle}" />
                </StackPanel>

                <TextBlock Text="Davranış" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Margin="0,24,0,8" />
                <CheckBox Content="Odak kaybolunca pencereyi gizle" IsChecked="{Binding HideOnFocusLost}" Style="{StaticResource DarkCheckBoxStyle}" />
                <CheckBox Content="Windows açılışında başlat" IsChecked="{Binding StartOnSystemStartup}" Style="{StaticResource DarkCheckBoxStyle}" Margin="0,8,0,0" />

                <Grid Margin="0,24,0,8">
                    <TextBlock Text="Arama kaynakları" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" />
                    <Button Content="+ Ekle" HorizontalAlignment="Right" Style="{StaticResource PushButtonStyle}" Click="OnAddSource" />
                </Grid>
                <ItemsControl ItemsSource="{Binding Sources}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <CheckBox Grid.Column="0" IsChecked="{Binding Enabled}" Style="{StaticResource DarkCheckBoxStyle}"
                                          ToolTip="Etkin" Margin="0,0,10,0" />
                                <TextBox Grid.Column="1" Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource FieldTextBoxStyle}" Margin="0,0,6,0" ToolTip="Başlık" />
                                <TextBox Grid.Column="2" Text="{Binding ActionKeyword, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource FieldTextBoxStyle}" Margin="0,0,6,0" ToolTip="Anahtar kelime" />
                                <TextBox Grid.Column="3" Text="{Binding UrlTemplate, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource FieldTextBoxStyle}" Margin="0,0,6,0" ToolTip="Adres şablonu" />
                                <Button Grid.Column="4" Content="&#xE74D;" FontFamily="{StaticResource IconFont}"
                                        Style="{StaticResource PushButtonStyle}" Padding="10,6" ToolTip="Sil"
                                        Tag="{Binding}" Click="OnRemoveSource" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="Adreste {q} varsa arama yapar, yoksa siteyi açar." Foreground="{StaticResource SubTextBrush}" FontSize="12" Margin="0,0,0,8" TextWrapping="Wrap" />

                <TextBlock Text="Gizlenen uygulamalar" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Margin="0,24,0,8" />
                <TextBlock Text="Eylem menüsünden (Ctrl+K) gizlenen uygulamalar aramada çıkmaz. &quot;Göster&quot; hemen uygulanır; &quot;Geri al&quot; bunu geri almaz."
                           FontSize="12" Foreground="{StaticResource SubTextBrush}" TextWrapping="Wrap" Margin="0,0,0,8" />
                <TextBlock Text="Gizlenen uygulama yok." FontSize="13" Foreground="{StaticResource SubTextBrush}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasHiddenPrograms}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <ItemsControl ItemsSource="{Binding HiddenPrograms}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="13" Foreground="{StaticResource TextBrush}"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Id}" />
                                <Button Grid.Column="1" Content="Göster" Style="{StaticResource PushButtonStyle}"
                                        Tag="{Binding}" Click="OnUnhideProgram" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="1" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{Binding Message}" TextWrapping="Wrap"
                       VerticalAlignment="Center" Margin="0,0,12,0" FontSize="12.5">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsError}" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource ErrorBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="Geri al" Style="{StaticResource PushButtonStyle}" Margin="0,0,8,0" Click="OnRevert" />
                <Button Content="Uygula" Style="{StaticResource AccentButtonStyle}" Margin="0,0,8,0" Click="OnApply" IsDefault="True" />
                <Button Content="Kapat" Style="{StaticResource PushButtonStyle}" Click="OnClose" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
