<Window x:Class="Launchly.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Launchly.App.ViewModels"
        Title="Launchly"
        Width="760"
        SizeToContent="Height"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        Background="Transparent"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </Window.Resources>
    <Border Background="{DynamicResource WindowBackgroundBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Arama kutusu -->
            <Border Grid.Row="0" Height="68" BorderBrush="{StaticResource AccentBrush}" BorderThickness="0,0,0,2">
                <Grid Margin="22,0,22,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="&#xE721;" FontFamily="{StaticResource IconFont}"
                               FontSize="20" Foreground="{StaticResource SubTextBrush}"
                               VerticalAlignment="Center" Margin="0,0,14,0" />
                    <TextBox x:Name="SearchBox" Grid.Column="1"
                             Style="{StaticResource SearchTextBoxStyle}"
                             Text="{Binding QueryText, UpdateSourceTrigger=PropertyChanged}"
                             VerticalAlignment="Center" />
                </Grid>
            </Border>

            <!-- Eylem menüsü (Ctrl+K / Actions): sonuç listesinin yerinde; Popup kullanılmaz (odak/topmost sorunları) -->
            <StackPanel Grid.Row="1"
                        Visibility="{Binding IsActionMenuOpen, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding ActionMenuTitle}" FontSize="12" FontWeight="SemiBold"
                           Foreground="{StaticResource SubTextBrush}" TextTrimming="CharacterEllipsis"
                           Margin="20,10,20,4" />
                <ListView x:Name="ActionList" MaxHeight="400"
                          Style="{StaticResource ResultListStyle}"
                          ItemContainerStyle="{StaticResource ResultItemStyle}"
                          ItemsSource="{Binding ActionItems}"
                          SelectedIndex="{Binding SelectedActionIndex, Mode=TwoWay}"
                          SelectionMode="Single">
                    <ListView.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:ActionItemViewModel}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Width="34" Text="{Binding Glyph}"
                                           FontFamily="{StaticResource IconFont}" FontSize="16"
                                           Foreground="{StaticResource SubTextBrush}" TextAlignment="Center"
                                           VerticalAlignment="Center" Margin="0,0,14,0" />
                                <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="15"
                                           Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="2" Text="{Binding Hint}" FontSize="12"
                                           Foreground="{StaticResource SubTextBrush}" VerticalAlignment="Center"
                                           Margin="12,0,0,0"
                                           Visibility="{Binding HasHint, Converter={StaticResource BoolToVisibility}}" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </StackPanel>

            <!-- Sonuç listesi (menü açıkken gizli) -->
            <ListView x:Name="ResultList" Grid.Row="1" MaxHeight="430"
                      ItemContainerStyle="{StaticResource ResultItemStyle}"
                      ItemsSource="{Binding Results}"
                      SelectedIndex="{Binding SelectedIndex, Mode=TwoWay}"
                      SelectionMode="Single">
                <ListView.Style>
                    <Style TargetType="ListView" BasedOn="{StaticResource ResultListStyle}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsActionMenuOpen}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ListView.Style>
                <ListView.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:ResultItemViewModel}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="34" Height="34" CornerRadius="8"
                                    Background="{Binding IconColor}" Margin="0,0,14,0">
                                <Grid>
                                    <Image Source="{Binding Image}" Width="28" Height="28"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           RenderOptions.BitmapScalingMode="HighQuality" />
                                    <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}"
                                               FontSize="18" Foreground="White"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Initial}" FontSize="16" FontWeight="SemiBold"
                                               Foreground="White"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Title}" FontSize="16"
                                           Foreground="{StaticResource TextBrush}"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding SubTitle}" FontSize="12"
                                           Foreground="{StaticResource SubTextBrush}"
                                           TextTrimming="CharacterEllipsis">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasSubTitle}" Value="False">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="{Binding TypeLabel}" FontSize="13"
                                       Foreground="{StaticResource SubTextBrush}" VerticalAlignment="Center"
                                       Margin="12,0,0,0" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <!-- Alt çubuk -->
            <Border Grid.Row="2" Height="40" Background="{DynamicResource FooterBrush}"
                    BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,1,0,0">
                <Grid Margin="12,0">
                    <Button x:Name="SettingsButton" Content="Settings" HorizontalAlignment="Left"
                            Style="{StaticResource FooterButtonStyle}" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <TextBlock Text="Ctrl+Shift+Enter Yönetici" FontSize="12"
                                   Foreground="{StaticResource SubTextBrush}" VerticalAlignment="Center"
                                   Margin="0,0,10,0"
                                   Visibility="{Binding CanRunSelectedAsAdmin, Converter={StaticResource BoolToVisibility}}" />
                        <Button x:Name="ActionsButton" Content="Actions"
                                Style="{StaticResource FooterButtonStyle}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
